@{ // How to call:
    //   @RenderPage("~/Pages/Component/PageHeader.cshtml", "Filters Window")
    //
    //   title : text shown in the band

    var title = PageData[0] as string;
    string userId = Session["idnumber"] as string;
    var date = DateTime.Now.ToString("MMM/dd/yyyy");
}

<link href="~/Pages/Style/pagebanner.css" rel="stylesheet" />
<div class="page-banner">
    <label class="page-banner-title">@title</label>
    <label class="page-banner-date">@date</label>
    <label class="page-banner-uid"><i class="bi bi-person-circle"></i>@userId</label>
</div>