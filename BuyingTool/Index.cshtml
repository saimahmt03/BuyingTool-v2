@using BuyingTool.Services
@using BuyingTool.DTO.Request
@{
    UserAccountService userAccountService = new UserAccountService();
    Service service = new Service();

    Layout = null;

    // Handle Logout action if posted back
    if (IsPost && Request.Form["actionButton"] == "Logout")
    {
        string userId = Session["idnumber"] as string;
        if (!string.IsNullOrEmpty(userId))
        {
            //service.ClearFiltersWindowCache(userId);
            service.ClearFinalDataSetFilterCache(userId);
            service.ClearGetFiltersAttributeCache(userId);
            service.ClearGetFiltersOrganizationCache(userId);
            service.ClearGetFiltersRequiredCache(userId);
            service.ClearGetFiltersStylesCache(userId);
        }

        Session.Clear();
        Session.Abandon();

        Response.Redirect("~/Index.cshtml");
        return;
    }

    // Check if the user is already logged in via Session
    bool isLoggedIn = Session["idnumber"] != null && !string.IsNullOrWhiteSpace(Session["idnumber"].ToString());

    string errorMessage = string.Empty;

    // Handle Login postback if not logged in
    if (!isLoggedIn && IsPost)
    {
        string action = Request.Form["actionButton"];
        string idnumber = Request.Form["idnumber"];
        string pass = Request.Form["password"];

        //System.Diagnostics.Debug.WriteLine("DEBUG ID NUMBER RECEIVED: " + idnumber);

        UserRequired useraccount = new UserRequired
        {
            Id_Number = idnumber,
            Password = pass
        };

        if (action == "Login")
        {
            string user = userAccountService.ValidateUser(useraccount);

            if (!string.IsNullOrEmpty(user))
            {

                if (user == "User does not exist, please try again.")
                {
                    errorMessage = user;
                }
                else
                {
                    // Save session and reload Index to transition to Main.cshtml
                    Session["idnumber"] = idnumber;
                    Response.Redirect("~/Index.cshtml");
                    return;
                }
            }
            else
            {
                errorMessage = "Invalid ID Number or Password.";
            }
        }

    }

    bool isCalculated = Session["IsCalculated"] != null && (bool)Session["IsCalculated"];

    isLoggedIn = Session["idnumber"] != null &&
             !string.IsNullOrWhiteSpace(Session["idnumber"].ToString());
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css">
<script src="~/Pages/Scripts/JQuery4.js"></script>
<script src="~/Pages/Scripts/Index.js"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(isLoggedIn ? "Dashboard" : "Login - Buying Tool Report")</title>

    @if (!isLoggedIn)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/Pages/Style/login.css" rel="stylesheet" />
    }
</head>
<body>
    <div id="loaderOverlay">
        <div id="loader"></div>
    </div>
    @if (!isLoggedIn)
    {
        // --- VIEW 1: LOGIN SCREEN ---
        <main class="login-shell" role="main">

            <section class="login-brand-panel" aria-label="Company values">

                <div class="brand-content">

                    <div class="fast-brand" aria-label="We act F.A.S.T.">
                        <p class="fast-expansion">RETAIL PLANNING WORKSPACE</p>
                    </div>

                    <div class="values-list">

                        <article class="value-item">
                            <h2>Plan smarter.</h2>
                        </article>
                        <br />


                        <article class="value-item">
                            <h2>Allocate better.</h2>
                        </article>
                        <br />

                    </div>

                    <div>
                        <article class="line-brand">
                            <p>Use historical performance, product attributes, and store-level data to build the right assortment for every site.</p>
                        </article>
                    </div>

                </div>

                <div class="brand-footer">Buying Tool Authorize Users Only</div>

            </section>

            <section class="login-form-panel" aria-label="Account sign in">

                <div class="login-card">
                    <div class="login-heading">
                        <h1>Welcome back</h1>
                        <p>Enter your Buying Tool credentials to continue.</p>
                    </div>
                    <form method="post" class="login-form" id="loginForm" novalidate>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger login-error" role="alert">
                                <span class="error-icon" aria-hidden="true">!</span>
                                <span>@errorMessage</span>
                            </div>
                        }
                        <div class="mb-3 login-field">
                            <label for="idnumber" class="form-label">User ID</label>
                            <div class="input-with-icon">
                                <span class="field-icon" aria-hidden="true">&#128100;</span>
                                <input type="text" class="form-control" id="idnumber" name="idnumber"
                                       placeholder="Enter your ID number" inputmode="numeric"
                                       autocomplete="username" required />
                            </div>
                            <div class="invalid-feedback">Please enter your ID number.</div>
                        </div>
                        <div class="mb-2 login-field">
                            <label for="password" class="form-label">Password</label>
                            <div class="input-with-icon password-wrap">
                                <span class="field-icon" aria-hidden="true">&#128274;</span>
                                <input type="password" class="form-control" id="password" name="password"
                                       placeholder="Enter your password" autocomplete="current-password" required />
                                <button type="button" class="password-toggle" id="togglePassword"
                                        aria-label="Show password" aria-pressed="false">
                                    <span class="toggle-label">Show</span>
                                </button>
                            </div>
                            <div class="invalid-feedback">Please enter your password.</div>
                        </div>
                        <input type="hidden" name="actionButton" value="Login" />
                        <button type="submit" class="btn login-submit" id="loginButton">
                            <span class="button-text">Sign in</span>
                            <span class="button-spinner spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span class="button-arrow" aria-hidden="true">&#8594;</span>
                        </button>
                    </form>

                </div>
                <div class="mobile-brand-footer">BUYING &amp; ALLOCATION REPORT</div>

            </section>
        </main>
    }
    else
    {
        // --- VIEW 2: DASHBOARD TABS (Loads Main.cshtml when Session[idnumber] is active) ---
        var activeTab = Request.QueryString["tab"];
        if (string.IsNullOrWhiteSpace(activeTab))
        {
            activeTab = "Main";
        }

        var sidebarCss = System.IO.File
            .GetLastWriteTime(Server.MapPath("~/Pages/Style/sidebar.css"))
            .Ticks.ToString();

        var indexCss = System.IO.File
            .GetLastWriteTime(Server.MapPath("~/Pages/Style/index.css"))
            .Ticks.ToString();

        <link href="~/Pages/Style/sidebar.css?v=@sidebarCss" rel="stylesheet" />
        <link href="~/Pages/Style/index.css?v=@indexCss" rel="stylesheet" />

        <!-- Render Sidebar Direct Component -->
        @RenderPage("~/Pages/Component/SideBar.cshtml", activeTab)
 

        <main class="content-wrapper" role="main">
            @if (activeTab == "Main")
            {
                <section id="tab-main" class="tab-pane" aria-label="Main Content">
                    @RenderPage("~/Pages/Component/Main.cshtml", activeTab)
                </section>
            }
            else if (activeTab == "1. Set Filters")
            {
                <section id="tab-1.-set-filters" class="tab-pane" aria-label="Set Filters">
                    @RenderPage("~/Pages/Component/SetFiltersWindow.cshtml", activeTab)
                </section>
            }
            else if (activeTab == "2. Review Summary")
            {
                <section id="tab-2.-review-summary" class="tab-pane" aria-label="Review Summary">
                    @RenderPage("~/Pages/Component/ReviewSummary.cshtml", activeTab)
                </section>
            }
            else if (activeTab == "3. Review Site Details")
            {
                <section id="tab-3.-review-site-details" class="tab-pane" aria-label="Review Site Details">
                    @RenderPage("~/Pages/Component/ReviewSiteDetails.cshtml", activeTab)
                </section>
            }
            else if (activeTab == "4. Export")
            {
                <section id="tab-4.-export" class="tab-pane" aria-label="Export">
                    @RenderPage("~/Pages/Component/Export.cshtml", activeTab)
                </section>
            }
            else if (activeTab == "Size Curve")
            {
                <section id="tab-size-curve" class="tab-pane" aria-label="Size Curve">
                    @RenderPage("~/Pages/Component/SizeCurve.cshtml", activeTab)
                </section>
            }
            else if (activeTab == "Monitoring")
            {
                <section id="tab-size-curve" class="tab-pane" aria-label="Size Curve">
                    @RenderPage("~/Pages/Component/Monitoring.cshtml", activeTab)
                </section>
            }
        </main>
    }

    @{
        var idnumberforlabel = Session["idnumber"] ?? "";
        if (Session["CalculationDone"] != null)
        {
            <p id="calculationdone" hidden>true</p>
        }
        else
        {
            <p id="calculationdone" hidden>false</p>
        }
        var sessionBrand = Session["Brand"];
        var sessionDivision = Session["Division"];
        var sessionCategory = Session["Category"];
        var sessionDepartment = Session["Department"];
        var sessionPeriodPlan = Session["PeriodPlan"];
        var sessionCollection = Session["Collection"];
        var sessionStyle = Session["Style"];
        var sessionStyleCode = Session["StyleCode"];

        var sessionRegion = Session["Region"];
        var sessionCountry = Session["Country"];
        var sessionChannel = Session["Channel"];
        var sessionTerritory = Session["Territory"];
        var sessionArea = Session["Area"];
        var sessionOutletType = Session["OutletType"];
        var sessionSiteCode = Session["SiteCode"];
        var sessionSiteName = Session["SiteName"];
        var sessionStoreGrade = Session["StoreGrade"];

        var sessionColor = Session["Color"];
        var sessionSilhouette = Session["Silhouette"];
        var sessionCollectionAttri = Session["CollectionAttri"];
        var sessionFitCut = Session["FitCut"];
        var sessionMaterialComposition = Session["MaterialComposition"];
        var sessionMaterialConstruction = Session["MaterialConstruction"];
        var sessionPrintTexture = Session["PrintTexture"];
        var sessionProductLine = Session["ProductLine"];
        var sessionSleeveType = Session["SleeveType"];
        var sessionStyleCollection = Session["StyleCollection"];
        var sessionSubCategory = Session["SubCategory"];
        var sessionSizeGroup = Session["SizeGroup"];
        var sessionOrigSrp = Session["OrigSrp"];
    }

    <label hidden id="idnumber">@idnumberforlabel</label>

    <label hidden id="sessionBrand">@sessionBrand</label>
    <label hidden id="sessionDivision">@sessionDivision</label>
    <label hidden id="sessionCategory">@sessionCategory</label>
    <label hidden id="sessionDepartment">@sessionDepartment</label>
    <label hidden id="sessionPeriodPlan">@sessionPeriodPlan</label>
    <label hidden id="sessionCollection">@sessionCollection</label>
    <label hidden id="sessionStyle">@sessionStyle</label>
    <label hidden id="sessionStyleCode">@sessionStyleCode</label>

    <label hidden id="sessionRegion">@sessionRegion</label>
    <label hidden id="sessionCountry">@sessionCountry</label>
    <label hidden id="sessionChannel">@sessionChannel</label>
    <label hidden id="sessionTerritory">@sessionTerritory</label>
    <label hidden id="sessionArea">@sessionArea</label>
    <label hidden id="sessionOutletType">@sessionOutletType</label>
    <label hidden id="sessionSiteCode">@sessionSiteCode</label>
    <label hidden id="sessionSiteName">@sessionSiteName</label>
    <label hidden id="sessionStoreGrade">@sessionStoreGrade</label>

    <label hidden id="sessionColor">@sessionColor</label>
    <label hidden id="sessionSilhouette">@sessionSilhouette</label>
    <label hidden id="sessionCollectionAttri">@sessionCollectionAttri</label>
    <label hidden id="sessionFitCut">@sessionFitCut</label>
    <label hidden id="sessionMaterialComposition">@sessionMaterialComposition</label>
    <label hidden id="sessionMaterialConstruction">@sessionMaterialConstruction</label>
    <label hidden id="sessionPrintTexture">@sessionPrintTexture</label>
    <label hidden id="sessionProductLine">@sessionProductLine</label>
    <label hidden id="sessionSleeveType">@sessionSleeveType</label>
    <label hidden id="sessionStyleCollection">@sessionStyleCollection</label>
    <label hidden id="sessionSubCategory">@sessionSubCategory</label>
    <label hidden id="sessionSizeGroup">@sessionSizeGroup</label>
    <label hidden id="sessionOrigSrp">@sessionOrigSrp</label>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @if (!isLoggedIn)
    {
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/Pages/Scripts/login.js"></script>
    }

    <script src="~/Pages/Scripts/sidebar.js"></script>

</body>
</html>

<style>
    #loaderOverlay {
        position: fixed;
        width: 100vw;
        height: 100vh;
        display: grid;
        background-color: rgba(255,255,255,0.5);
        z-index: 99;
        visibility: hidden;
    }
    html {
        font-family: 'Roboto';
    }
    #loader {
        place-self: center;
        border: 16px solid #f3f3f3; /* Light grey */
        border-top: 16px solid #3498db; /* Blue */
        border-radius: 50%;
        width: 120px;
        height: 120px;
        animation: spin 2s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>